{
  "schema_version": 1,
  "name": "base",
  "description": "Base C/C++, DRM, and Wayland development sysroot for CM0 AArch64 applications",
  "development_packages": [
    "libdrm-dev",
    "libpciaccess-dev",
    "libwayland-dev",
    "libxkbcommon-dev",
    "libffi-dev"
  ],
  "export_paths": [
    "lib/aarch64-linux-gnu",
    "lib/ld-linux-aarch64.so.1",
    "usr/include",
    "usr/lib/linux",
    "usr/lib/aarch64-linux-gnu",
    "usr/lib/gcc/aarch64-linux-gnu",
    "usr/lib/pkgconfig",
    "usr/local/include",
    "usr/local/lib",
    "usr/share/pkgconfig",
    "etc/ld.so.conf",
    "etc/ld.so.conf.d",
    "etc/os-release",
    "var/lib/dpkg/status"
  ],
  "required_paths": [
    "usr/include/stdio.h",
    "usr/include/aarch64-linux-gnu/bits/libc-header-start.h",
    "usr/lib/linux/uapi/arm64/asm/errno.h",
    "usr/lib/linux/uapi/arm64/asm/types.h",
    "usr/include/xf86drm.h",
    "usr/include/libdrm/drm.h",
    "usr/include/pciaccess.h",
    "usr/include/wayland-client.h",
    "usr/include/wayland-cursor.h",
    "usr/include/xkbcommon/xkbcommon.h",
    "usr/include/aarch64-linux-gnu/ffi.h",
    "lib/ld-linux-aarch64.so.1",
    "usr/lib/aarch64-linux-gnu/crt1.o",
    "usr/lib/aarch64-linux-gnu/libc.so",
    "usr/lib/aarch64-linux-gnu/libdrm.so",
    "usr/lib/aarch64-linux-gnu/libwayland-client.so",
    "usr/lib/aarch64-linux-gnu/libwayland-cursor.so",
    "usr/lib/aarch64-linux-gnu/libxkbcommon.so",
    "usr/lib/aarch64-linux-gnu/libffi.so",
    "usr/lib/aarch64-linux-gnu/pkgconfig/libdrm.pc",
    "usr/lib/aarch64-linux-gnu/pkgconfig/pciaccess.pc",
    "usr/lib/aarch64-linux-gnu/pkgconfig/wayland-client.pc",
    "usr/lib/aarch64-linux-gnu/pkgconfig/wayland-cursor.pc",
    "usr/lib/aarch64-linux-gnu/pkgconfig/xkbcommon.pc",
    "usr/lib/aarch64-linux-gnu/pkgconfig/libffi.pc"
  ]
}
